# ============================================
# OJ API GATEWAY - ENVIRONMENT VARIABLES EXAMPLE
# ============================================
# Copy this file to .env and update values for your environment


# ============================================
# SPRING BOOT CONFIGURATION
# ============================================

OJ_SPRING_PROFILES_ACTIVE=local
OJ_APP_URL=http://localhost:8080

# ============================================
# SERVER CONFIGURATION
# ============================================

OJ_SERVER_PORT=8080
OJ_SERVLET_CONTEXT_PATH=/

# ============================================
# DATABASE CONFIGURATION
# ============================================

OJ_DB_URL=jdbc:postgresql://localhost:5432/oj_cpp
OJ_DB_USERNAME=oj_dev
OJ_DB_PASSWORD=DevOJ@123

# ============================================
# REDIS CONFIGURATION
# ============================================

OJ_REDIS_HOST=localhost
OJ_REDIS_PORT=6379
OJ_REDIS_PASSWORD=

# ============================================
# LOGGING
# ============================================

LOGGING_LEVEL_COM_OJ=DEBUG
LOGGING_LEVEL_ROOT=INFO

# ============================================
# SECURITY
# ============================================

OJ_JWT_SECRET=your-secret-key-change-this-in-production-min-256-bits-long-for-security
OJ_JWT_EXPIRATION=86400
OJ_JWT_REFRESH_EXPIRATION=604800

# ============================================
# FILE STORAGE
# ============================================

OJ_STORAGE_DEFAULT=private
OJ_STORAGE_APP_PUBLIC_ROOT=storage/app/public
OJ_STORAGE_APP_PRIVATE_ROOT=storage/app/private

# ============================================
# MONITORING & METRICS
# ============================================

OJ_MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
OJ_MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
OJ_MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# ============================================
# DEVELOPMENT
# ============================================

DEBUG=true
FLYWAY_CLEAN_DISABLED=false
FLYWAY_TABLE=flyway_sql_histories

